# Application Configuration
PROJECT_NAME="Social Media Studio"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///./social_media.db"

# Selected Publisher Adapter
# Options: "mock_x", "mock_linkedin", or "telegram"
DEFAULT_PUBLISHER="mock_x"

# Platform Adapters Configuration
# Telegram: Real platform integration.
# OPTIONAL: Only required if DEFAULT_PUBLISHER="telegram" or when manually targeting telegram.
# Replace with your actual Bot token from @BotFather and numeric Chat ID.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"

# Mock Platform Adapters Configuration
ENABLE_MOCK_X=True
ENABLE_MOCK_LINKEDIN=True

# Background Scheduler Configuration
SCHEDULER_POLL_INTERVAL_SECONDS=2.0
SCHEDULER_BATCH_SIZE=10
