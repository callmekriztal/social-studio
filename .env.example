# ==============================================================================
# Environment Configuration Template for Social Media Studio
# Copy this file to .env and adjust values for local development or production.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Social Media Studio"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="sqlite:///./social_media.db"

# Production Managed PostgreSQL (e.g. Neon, Supabase, Render):
# DATABASE_URL="postgresql://neondb_owner:npg_SecretPass123@ep-cool-fog-123456.us-east-2.aws.neon.tech/social_media?sslmode=require"

# ------------------------------------------------------------------------------
# Selected Publisher Adapter
# ------------------------------------------------------------------------------
# Options: "mock_x", "mock_linkedin", or "telegram"
# In mock mode, no external credentials or network connectivity are required.
DEFAULT_PUBLISHER="mock_x"

# ------------------------------------------------------------------------------
# Telegram Platform Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Only required if DEFAULT_PUBLISHER="telegram" or when manually publishing to Telegram.
# Obtain token from @BotFather and numeric channel/chat ID (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# Mock Platform Adapters Configuration
# ------------------------------------------------------------------------------
ENABLE_MOCK_X=True
ENABLE_MOCK_LINKEDIN=True

# ------------------------------------------------------------------------------
# Background Scheduler Configuration
# ------------------------------------------------------------------------------
# Frequency in seconds at which the background worker polls for due slots:
SCHEDULER_POLL_INTERVAL_SECONDS=2.0

# Maximum number of due slots processed in a single worker execution batch:
SCHEDULER_BATCH_SIZE=10
